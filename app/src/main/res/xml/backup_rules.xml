<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy backup rules (Android 6–11) for Hazel.

    Includes DataStore preferences so cookies, search history, download
    history, and settings survive cloud restores. Cache is excluded.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="remote_bridge_secure.xml" />
    <exclude domain="sharedpref" path="remote_bridge_jobs.xml" />
</full-backup-content>
